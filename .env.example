# ============================================================
# LAKERS STORE - Variables d'environnement du frontend
# Copie ce fichier en « .env » puis remplis tes valeurs.
# Les variables VITE_* sont exposées au navigateur (donc publiques).
# ============================================================

# --- Supabase (Paramètres > API dans le tableau de bord Supabase) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Administrateur ---
VITE_ADMIN_EMAIL=wenceslastoyin@gmail.com
VITE_ADMIN_WHATSAPP=+22950813586

# --- Nom du site ---
VITE_SITE_NAME=LAKERS STORE

# --- FedaPay (clé PUBLIQUE uniquement côté frontend, mode test) ---
# Mode test : https://sandbox.fedapay.com  |  Mode live : https://live.fedapay.com
VITE_FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxxxx
VITE_FEDAPAY_ENV=sandbox

# --- URL de base de l'application (pour les liens dans les e-mails) ---
VITE_APP_URL=http://localhost:5173

# --- Notifications push navigateur (Web Push) ---
# La clé PUBLIQUE est exposée au navigateur ; la clé privée reste SECRÈTE
# et se configure uniquement dans les secrets des Edge Functions (voir SETUP.md).
VITE_VAPID_PUBLIC_KEY=BIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
